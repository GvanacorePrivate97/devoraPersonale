# Copia in .env e adatta. Non committare .env.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Postgres. In locale (senza Docker) il database gira su 55432 via Postgres.app;
# con docker compose l'host diventa "db" e la porta 5432.
DATABASE_URL=postgres://postgres@localhost:55432/mencare

# Firme JWT. In produzione: stringhe casuali di almeno 32 caratteri, diverse fra loro.
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30

# Origini ammesse dalle app (CORS). Separate da virgola.
CORS_ORIGINS=http://localhost:3000

# Notifiche push: "log" scrive nel log e crea la notifica in app, "fcm" usa Firebase.
PUSH_PROVIDER=log
FCM_SERVICE_ACCOUNT_JSON=

# Avatar caricati dalle app.
UPLOADS_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:3000

# Fuso orario del salone: decide giorni, griglie orarie e promemoria.
SALON_TIMEZONE=Europe/Rome
