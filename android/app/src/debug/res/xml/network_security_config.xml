<?xml version="1.0" encoding="utf-8"?>
<!--
  Solo per la variante di debug.

  In produzione vale il file in `src/main`: niente traffico in chiaro, punto.
  Qui c'è l'unica eccezione che serve davvero a lavorare — il backend gira sul
  computer di chi sviluppa, in HTTP, e l'emulatore lo raggiunge su `10.0.2.2`
  (che è il loopback dell'host visto da dentro l'emulatore). Un dispositivo
  fisico in rete locale non è previsto: se serve, si mette un certificato.

  Non serve toccare il manifest: il file di debug prende il posto di quello
  di `main` solo in questa variante, quindi nell'APK di release non c'è modo
  di spedire un'app che accetta HTTP per sbaglio. `usesCleartextTraffic`
  resta `false` ovunque: è la configurazione di rete a concedere l'eccezione.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
